import FusionCategory.DerivedJScalar
import FusionCategory.Gauge

/-!
# The associator (F-cochain) gauge and the derived twist

`DerivedJScalar.lean` computes the double-dual twist from `(ring, F, Finv, ev,
coev)` and `Gauge.lean` shows it is invariant under the *vertex* gauge
(`coev i ↦ λ i • coev i`, `ev i ↦ ev i / λ i`), i.e. under the freedom in the
duality normalisation.  The other normalisation the closed form depends on is
the choice of *associator representative*: `comparisonScalar` is a monomial in
`F` and `Finv`, so a rescaling of the associator by a vertex cochain moves it.

This file constructs that gauge.  For a cochain `g : Fin n → Fin n → Fin n → kˣ`
(the value at the `(a, b, e)`-vertex with `e` the channel of `a ⊗ b`), each block
of the associator is rescaled by a *row* and a *column* factor

  `F a b c d e f  ↦  F a b c d e f · (row(e) / col(f))`,
  `Finv a b c d f e ↦ Finv a b c d f e · (col(f) / row(e))`,

which is the standard gauge freedom of `F`-symbols.  The two inverse laws see a
single block and are preserved termwise (the `e`-dependent factors cancel
inside each summand); the pentagon is preserved because the product of the three
gauge factors along a pentagon summand is independent of the summed channel;
the unit laws and the snake equations are preserved for a cochain that is `1`
on the unit legs and on the dual leg `(a*, a, 1)`.

The result is a new `FusionSystem` with the same `ring`, `ev`, `coev` and the
same carried twist `J` (the axiom `J_coherent` retains its `F` factors on both
sides, so it survives a nonzero rescaling of `F` — this is exactly why the
signature keeps them).

## The main theorem: the derived twist does not see the gauge

Both comparison scalars — `ψ_{a,b}|_c` and `ψ_{b*,a*}|_{c*}` — are multiplied by
the *same* factor `g (b*, a*, c*) · g (a, b, c)`, so their ratio is untouched:

  `derivedJGen (assocGauge S g) a b c = derivedJGen S a b c`.

This is the associator analogue of `derivedJGen_gauge`, and it needs *no*
condition on `g` beyond the normalisation that makes `assocGauge` a datum (the
vertex-gauge invariance needs `λ` dual-invariant).  Together they say that the
derived twist is invariant under the group generated by the two gauge freedoms
of the signature (`derivedJGen_gauge_assocGauge`).

The gauge is nevertheless *not* trivial on the data: `assocGaugeF_ne_self` shows
that a block whose row and column factors differ is rescaled, and
`assocGauge_exists_nontrivial` shows the admissible cochains are not all `1`.
What the gauge cannot do is move zeros: `assocGaugeF_eq_zero_iff` and
`assocGaugeFinv_eq_zero_iff` say the vanishing pattern of `F` and `Finv` is
invariant — so no associator gauge can create or destroy the nonvanishing
hypothesis that the conditional form of `DoubleDualTensorator.derivedJGen_eq_omegaCoeff`
carries.  (Recorded so that the nonvanishing direction does not spend effort on
this gauge.)

§8 records the companion canonicity result: `Finv` is *determined* by `(ring, F)`
(`finv_eq_of_same_F`), so `derivedJGen` is a function of `(ring, F, ev)` alone —
the inverse data is a presentation artefact, not an input of the computation.

The §6 corollaries transfer the invariance to the frozen interface at `ℂ`: the
`derivedJ` of `Statements2` is unchanged (`derivedJ_assocGauge`), so the frozen
`DerivedJ_ne_zero` and `DerivedJ_pointed_eq_delta_kappa` are statements about the
gauge *class* of the datum (`derivedJ_ne_zero_assocGauge_iff`,
`derivedJ_pointed_assocGauge_iff`).

Axiom budget: `[propext, Classical.choice, Quot.sound]`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

universe u

namespace FusionCategory

variable {n : ℕ} {k : Type u} [Field k]

/-! ## §1 — the gauge factors -/

/-- The row factor of the block `F^{abc}_d`: the gauge parameter at the vertex
`(a, b, e)`, `e` the channel of `a ⊗ b`. -/
def gaugeRowU (g : Fin n → Fin n → Fin n → kˣ) (a b c d e : Fin n) : kˣ :=
  g a b e * g e c d

/-- The column factor of the block `F^{abc}_d`: the gauge parameter at the
vertex `(b, c, f)`, `f` the channel of `b ⊗ c`. -/
def gaugeColU (g : Fin n → Fin n → Fin n → kˣ) (a b c d f : Fin n) : kˣ :=
  g b c f * g a f d

/-- The gauge factor of the entry `F a b c d e f`: `row(e) / col(f)`. -/
def assocGaugeFactor (g : Fin n → Fin n → Fin n → kˣ) (a b c d e f : Fin n) : kˣ :=
  gaugeRowU g a b c d e * (gaugeColU g a b c d f)⁻¹

@[simp] theorem gaugeColU_self_inv (g : Fin n → Fin n → Fin n → kˣ) (a b c d f : Fin n) :
    ((gaugeColU g a b c d f * (gaugeColU g a b c d f)⁻¹ : kˣ) : k) = 1 := by
  simp

@[simp] theorem gaugeRowU_self_inv (g : Fin n → Fin n → Fin n → kˣ) (a b c d e : Fin n) :
    ((gaugeRowU g a b c d e * (gaugeRowU g a b c d e)⁻¹ : kˣ) : k) = 1 := by
  simp

/-- **The pentagon summand is gauge-covariant with a channel-independent
factor**: the product of the three gauge factors of a pentagon summand does not
depend on the summed channel `kk`, and equals the product of the gauge factors
of the pentagon's right-hand side. -/
theorem assocGaugeFactor_pentagon (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d e i j r x kk : Fin n) :
    assocGaugeFactor g a b c x e kk * assocGaugeFactor g a kk d r x j *
        assocGaugeFactor g b c d j kk i =
      assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j := by
  simp only [assocGaugeFactor, gaugeRowU, gaugeColU]
  ext
  simp only [Units.val_mul, Units.val_inv_eq_inv_val]
  field_simp

-- (namespace continues)

/-! ## §2 — the gauged associator and its inverse -/

/-- The gauged associator. -/
def assocGaugeF (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d e f : Fin n) : k :=
  S.F a b c d e f * (assocGaugeFactor g a b c d e f : k)

/-- The gauged inverse associator: the inverse block is rescaled by the
reciprocal row and column factors, which is what makes the two inverse laws
hold termwise. -/
def assocGaugeFinv (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d f e : Fin n) : k :=
  S.Finv a b c d f e * ((gaugeColU g a b c d f * (gaugeRowU g a b c d e)⁻¹ : kˣ) : k)

/-- One summand of `Finv_comp`: the `e`-dependent factors cancel, so the whole
sum is the old one times a factor depending only on `f'` and `f`. -/
theorem assocGaugeFinv_mul_F (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d f' e f : Fin n) :
    assocGaugeFinv S g a b c d f' e * assocGaugeF S g a b c d e f =
      S.Finv a b c d f' e * S.F a b c d e f *
        ((gaugeColU g a b c d f' * (gaugeColU g a b c d f)⁻¹ : kˣ) : k) := by
  unfold assocGaugeFinv assocGaugeF assocGaugeFactor
  simp only [Units.val_mul, Units.val_inv_eq_inv_val]
  field_simp

/-- One summand of `F_comp_inv`: now the `f`-dependent factors cancel. -/
theorem assocGaugeFinv_mul_F' (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d f e' e : Fin n) :
    assocGaugeFinv S g a b c d f e' * assocGaugeF S g a b c d e f =
      S.Finv a b c d f e' * S.F a b c d e f *
        ((gaugeRowU g a b c d e * (gaugeRowU g a b c d e')⁻¹ : kˣ) : k) := by
  unfold assocGaugeFinv assocGaugeF assocGaugeFactor
  simp only [Units.val_mul, Units.val_inv_eq_inv_val]
  field_simp

/-- The gauge factor of `F^{abc}_d` on a unit leg (`a = 1`) is `1`. -/
theorem assocGaugeFactor_unit_left (g : Fin n → Fin n → Fin n → kˣ) (hn : 0 < n)
    (b c d : Fin n) (h1 : g ⟨0, hn⟩ b b = 1) (h2 : g ⟨0, hn⟩ d d = 1) :
    (assocGaugeFactor g ⟨0, hn⟩ b c d b d : k) = 1 := by
  unfold assocGaugeFactor gaugeRowU gaugeColU
  rw [h1, h2]
  simp

/-- The gauge factor of `F^{abc}_d` on a unit leg (`c = 1`) is `1`. -/
theorem assocGaugeFactor_unit_right (g : Fin n → Fin n → Fin n → kˣ) (hn : 0 < n)
    (a b e : Fin n) (h1 : g e ⟨0, hn⟩ e = 1) (h2 : g b ⟨0, hn⟩ b = 1) :
    (assocGaugeFactor g a b ⟨0, hn⟩ e e b : k) = 1 := by
  unfold assocGaugeFactor gaugeRowU gaugeColU
  rw [h1, h2]
  simp

/-- The gauge factor of the left snake entry `F^{i i* i}_i`. -/
theorem assocGaugeFactor_snake_left (S : FusionSystem n k)
    (g : Fin n → Fin n → Fin n → kˣ) (hn : 0 < n) (i : Fin n)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    (assocGaugeFactor g i (S.ring.dual i) i i ⟨0, hn⟩ ⟨0, hn⟩ : k) = 1 := by
  unfold assocGaugeFactor gaugeRowU gaugeColU
  have hdi : g i (S.ring.dual i) ⟨0, hn⟩ = 1 := by
    have h := hd hn (S.ring.dual i)
    rwa [S.ring.dual_dual] at h
  rw [hd hn i, h0' hn i, h0 hn i, hdi]
  simp

/-- The gauge factor of the right snake entry `Finv^{i* i i*}_{i*}`: the
reciprocal factor is `1` there too. -/
theorem assocGaugeFinvFactor_snake_right (S : FusionSystem n k)
    (g : Fin n → Fin n → Fin n → kˣ) (hn : 0 < n) (i : Fin n)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    ((gaugeColU g (S.ring.dual i) i (S.ring.dual i) (S.ring.dual i) ⟨0, hn⟩ *
      (gaugeRowU g (S.ring.dual i) i (S.ring.dual i) (S.ring.dual i) ⟨0, hn⟩)⁻¹ : kˣ) :
        k) = 1 := by
  unfold gaugeRowU gaugeColU
  have hdi : g i (S.ring.dual i) ⟨0, hn⟩ = 1 := by
    have h := hd hn (S.ring.dual i)
    rwa [S.ring.dual_dual] at h
  rw [hd hn i, h0' hn (S.ring.dual i), h0 hn (S.ring.dual i), hdi]
  simp

/-! ## §3 — the gauge on a `FusionSystem` -/

/-- **The associator (F-cochain) gauge of a datum.**  Each block of the
associator is rescaled by `row(e)/col(f)`, the inverse block by the reciprocal
factor; `ring`, `ev`, `coev` and the carried twist `J` are kept.

The cochain must be normalised on the labels the unit laws and the snakes see:
`g (1, b, b) = 1`, `g (a, 1, a) = 1`, and `g (a*, a, 1) = 1`. -/
noncomputable def assocGauge (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    FusionSystem n k where
  ring := S.ring
  mult_free := S.mult_free
  F := assocGaugeF S g
  F_support := by
    intro a b c d e f h
    show assocGaugeF S g a b c d e f = 0
    unfold assocGaugeF
    rw [S.F_support a b c d e f h, zero_mul]
  pentagon := by
    intro a b c d e i j r x
    show (∑ kk : Fin n, assocGaugeF S g a b c x e kk * assocGaugeF S g a kk d r x j *
        assocGaugeF S g b c d j kk i) =
      assocGaugeF S g e c d r x i * assocGaugeF S g a b i r e j
    have hterm : ∀ kk : Fin n,
        assocGaugeF S g a b c x e kk * assocGaugeF S g a kk d r x j *
            assocGaugeF S g b c d j kk i =
          S.F a b c x e kk * S.F a kk d r x j * S.F b c d j kk i *
            ((assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j : kˣ) : k) := by
      intro kk
      have h := assocGaugeFactor_pentagon g a b c d e i j r x kk
      have h' : ((assocGaugeFactor g a b c x e kk * assocGaugeFactor g a kk d r x j *
            assocGaugeFactor g b c d j kk i : kˣ) : k) =
          ((assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j : kˣ) : k) := by
        rw [h]
      simp only [Units.val_mul] at h'
      unfold assocGaugeF
      simp only [Units.val_mul]
      linear_combination (S.F a b c x e kk * S.F a kk d r x j * S.F b c d j kk i) * h'
    calc (∑ kk : Fin n, assocGaugeF S g a b c x e kk * assocGaugeF S g a kk d r x j *
          assocGaugeF S g b c d j kk i)
        = ∑ kk : Fin n, S.F a b c x e kk * S.F a kk d r x j * S.F b c d j kk i *
            ((assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j : kˣ) : k) :=
          Finset.sum_congr rfl fun kk _ => hterm kk
      _ = (∑ kk : Fin n, S.F a b c x e kk * S.F a kk d r x j * S.F b c d j kk i) *
            ((assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j : kˣ) : k) := by
          rw [Finset.sum_mul]
      _ = (S.F e c d r x i * S.F a b i r e j) *
            ((assocGaugeFactor g e c d r x i * assocGaugeFactor g a b i r e j : kˣ) : k) := by
          rw [S.pentagon]
      _ = assocGaugeF S g e c d r x i * assocGaugeF S g a b i r e j := by
          unfold assocGaugeF
          simp only [Units.val_mul]
          ring
  F_unit_left := by
    intro hn b c d f hf
    show assocGaugeF S g ⟨0, hn⟩ b c d b f = if d = f then 1 else 0
    by_cases h : d = f
    · subst h
      have hF := S.F_unit_left hn b c d d hf
      rw [if_pos rfl] at hF
      unfold assocGaugeF
      rw [hF, assocGaugeFactor_unit_left g hn b c d (h0 hn b) (h0 hn d)]
      simp
    · have hF := S.F_unit_left hn b c d f hf
      rw [if_neg h] at hF
      unfold assocGaugeF
      rw [hF, zero_mul, if_neg h]
  F_unit_right := by
    intro hn a b d e he
    show assocGaugeF S g a b ⟨0, hn⟩ d e b = if d = e then 1 else 0
    by_cases h : d = e
    · subst h
      have hF := S.F_unit_right hn a b d d he
      rw [if_pos rfl] at hF
      unfold assocGaugeF
      rw [hF, assocGaugeFactor_unit_right g hn a b d (h0' hn d) (h0' hn b)]
      simp
    · have hF := S.F_unit_right hn a b d e he
      rw [if_neg h] at hF
      unfold assocGaugeF
      rw [hF, zero_mul, if_neg h]
  Finv := assocGaugeFinv S g
  Finv_support := by
    intro a b c d f e h
    show assocGaugeFinv S g a b c d f e = 0
    unfold assocGaugeFinv
    rw [S.Finv_support a b c d f e h, zero_mul]
  Finv_comp := by
    intro a b c d f' f hf' haf'd hf hafd
    show (∑ e : Fin n, assocGaugeFinv S g a b c d f' e * assocGaugeF S g a b c d e f) =
      if f' = f then 1 else 0
    calc (∑ e : Fin n, assocGaugeFinv S g a b c d f' e * assocGaugeF S g a b c d e f)
        = ∑ e : Fin n, (S.Finv a b c d f' e * S.F a b c d e f) *
            ((gaugeColU g a b c d f' * (gaugeColU g a b c d f)⁻¹ : kˣ) : k) :=
          Finset.sum_congr rfl fun e _ => assocGaugeFinv_mul_F S g a b c d f' e f
      _ = (∑ e : Fin n, S.Finv a b c d f' e * S.F a b c d e f) *
            ((gaugeColU g a b c d f' * (gaugeColU g a b c d f)⁻¹ : kˣ) : k) := by
          rw [Finset.sum_mul]
      _ = (if f' = f then 1 else 0) *
            ((gaugeColU g a b c d f' * (gaugeColU g a b c d f)⁻¹ : kˣ) : k) := by
          rw [S.Finv_comp a b c d f' f hf' haf'd hf hafd]
      _ = (if f' = f then 1 else 0) := by
          by_cases h : f' = f
          · subst h
            rw [if_pos rfl, gaugeColU_self_inv, mul_one]
          · rw [if_neg h, zero_mul]
  F_comp_inv := by
    intro a b c d e' e he' he'd he hed
    show (∑ f : Fin n, assocGaugeFinv S g a b c d f e' * assocGaugeF S g a b c d e f) =
      if e' = e then 1 else 0
    calc (∑ f : Fin n, assocGaugeFinv S g a b c d f e' * assocGaugeF S g a b c d e f)
        = ∑ f : Fin n, (S.Finv a b c d f e' * S.F a b c d e f) *
            ((gaugeRowU g a b c d e * (gaugeRowU g a b c d e')⁻¹ : kˣ) : k) :=
          Finset.sum_congr rfl fun f _ => assocGaugeFinv_mul_F' S g a b c d f e' e
      _ = (∑ f : Fin n, S.Finv a b c d f e' * S.F a b c d e f) *
            ((gaugeRowU g a b c d e * (gaugeRowU g a b c d e')⁻¹ : kˣ) : k) := by
          rw [Finset.sum_mul]
      _ = (if e' = e then 1 else 0) *
            ((gaugeRowU g a b c d e * (gaugeRowU g a b c d e')⁻¹ : kˣ) : k) := by
          rw [S.F_comp_inv a b c d e' e he' he'd he hed]
      _ = (if e' = e then 1 else 0) := by
          by_cases h : e' = e
          · subst h
            rw [if_pos rfl, gaugeRowU_self_inv, mul_one]
          · rw [if_neg h, zero_mul]
  ev := S.ev
  coev := S.coev
  ev_ne_zero := S.ev_ne_zero
  coev_ne_zero := S.coev_ne_zero
  snake_left := by
    intro hn i
    show S.coev i * S.ev i * assocGaugeF S g i (S.ring.dual i) i i ⟨0, hn⟩ ⟨0, hn⟩ = 1
    unfold assocGaugeF
    rw [assocGaugeFactor_snake_left S g hn i h0 h0' hd, mul_one]
    exact S.snake_left hn i
  snake_right := by
    intro hn i
    show S.coev i * S.ev i *
      assocGaugeFinv S g (S.ring.dual i) i (S.ring.dual i) (S.ring.dual i) ⟨0, hn⟩ ⟨0, hn⟩ = 1
    unfold assocGaugeFinv
    rw [assocGaugeFinvFactor_snake_right S g hn i h0 h0' hd, mul_one]
    exact S.snake_right hn i
  ev_dual := S.ev_dual
  J := S.J
  J_ne_zero := S.J_ne_zero
  J_unit_left := S.J_unit_left
  J_unit_right := S.J_unit_right
  J_dual := S.J_dual
  J_coherent := by
    intro a b c d e f h1 h2 h3 h4
    show S.J a b e * S.J e c d * assocGaugeF S g a b c d e f =
      S.J b c f * S.J a f d * assocGaugeF S g a b c d e f
    unfold assocGaugeF
    linear_combination (assocGaugeFactor g a b c d e f : k) *
      S.J_coherent a b c d e f h1 h2 h3 h4

/-! ## §4 — the read-off lemmas and the transformation law -/

theorem assocGauge_ring (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    (assocGauge S g h0 h0' hd).ring = S.ring := rfl

theorem assocGauge_F (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (a b c d e f : Fin n) :
    (assocGauge S g h0 h0' hd).F a b c d e f = assocGaugeF S g a b c d e f := rfl

theorem assocGauge_Finv (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (a b c d f e : Fin n) :
    (assocGauge S g h0 h0' hd).Finv a b c d f e = assocGaugeFinv S g a b c d f e := rfl

theorem assocGauge_ev (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (i : Fin n) :
    (assocGauge S g h0 h0' hd).ev i = S.ev i := rfl

/-- **The denominator of the comparison scalar under the gauge**: the two
surviving vertex factors are exactly `g (y*, x*, z*) · g (x, y, z)`. -/
theorem assocGauge_denominator (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (hn : 0 < n) (x y z : Fin n) :
    assocGaugeF S g (S.ring.dual y) (S.ring.dual x) z ⟨0, hn⟩ (S.ring.dual z) y *
        assocGaugeFinv S g (S.ring.dual x) x y y z ⟨0, hn⟩ =
      (S.F (S.ring.dual y) (S.ring.dual x) z ⟨0, hn⟩ (S.ring.dual z) y *
          S.Finv (S.ring.dual x) x y y z ⟨0, hn⟩) *
        ((g (S.ring.dual y) (S.ring.dual x) (S.ring.dual z) : k) * (g x y z : k)) := by
  unfold assocGaugeF assocGaugeFinv assocGaugeFactor gaugeRowU gaugeColU
  rw [hd hn z, hd hn y, hd hn x, h0 hn y]
  simp only [Units.val_mul, Units.val_inv_eq_inv_val]
  field_simp
  norm_num

/-- **The comparison scalar under the associator gauge**: it is divided by
`g (y*, x*, z*) · g (x, y, z)`. -/
theorem comparisonScalar_assocGauge (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (x y z : Fin n) :
    comparisonScalar (assocGauge S g h0 h0' hd) x y z =
      comparisonScalar S x y z /
        ((g (S.ring.dual y) (S.ring.dual x) (S.ring.dual z) : k) * (g x y z : k)) := by
  unfold comparisonScalar
  by_cases hn : 0 < n
  · rw [dif_pos hn, dif_pos hn]
    rw [assocGauge_F, assocGauge_Finv, assocGauge_ring,
      assocGauge_denominator S g h0 h0' hd hn x y z]
    simp only [assocGauge_ev]
    have hx : S.ev x ≠ 0 := S.ev_ne_zero x
    have hy : S.ev y ≠ 0 := S.ev_ne_zero y
    have h1 : ((g (S.ring.dual y) (S.ring.dual x) (S.ring.dual z) : k)) ≠ 0 :=
      (g _ _ _).ne_zero
    have h2 : ((g x y z : k)) ≠ 0 := (g _ _ _).ne_zero
    field_simp
  · rw [dif_neg hn, dif_neg hn]
    simp

/-! ## §5 — the invariance of the derived twist -/

/-- **The derived twist is invariant under the associator gauge.**  Both
comparison scalars — `ψ_{a,b}|_c` and `ψ_{b*,a*}|_{c*}` — pick up the *same*
factor `g (b*, a*, c*) · g (a, b, c)`, so the twist, which is their ratio, does
not move.  Note what this does and does not need: unlike the vertex gauge
(`derivedJGen_gauge`, which needs `λ` dual-invariant), this invariance needs no
hypothesis on `g` beyond the normalisation that makes `assocGauge` a datum at
all.

So the associator representative is not part of what the derived twist sees,
even though `comparisonScalar` is a monomial in `F` and `Finv`: the twist is a
function of the *gauge class* of the associator, which is what an invariant of
the rigid structure has to be. -/
theorem derivedJGen_assocGauge (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (a b c : Fin n) :
    derivedJGen (assocGauge S g h0 h0' hd) a b c = derivedJGen S a b c := by
  unfold derivedJGen
  rw [assocGauge_ring]
  rw [comparisonScalar_assocGauge S g h0 h0' hd,
    comparisonScalar_assocGauge S g h0 h0' hd (S.ring.dual b) (S.ring.dual a) (S.ring.dual c)]
  simp only [FusionRing.dual_dual]
  have hD : ((g (S.ring.dual b) (S.ring.dual a) (S.ring.dual c) : k) * (g a b c : k)) ≠ 0 :=
    mul_ne_zero (g _ _ _).ne_zero (g _ _ _).ne_zero
  field_simp

/-- **The gauge is not vacuous on the data**: at a label pattern where the row
and column factors of a nonzero `F` entry differ, the gauged associator differs
from the original there.  So `assocGauge` really moves `F`, and the invariance
of `derivedJGen_assocGauge` is a statement about the twist, not about the gauge
being trivial. -/
theorem assocGaugeF_ne_self (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d e f : Fin n) (hF : S.F a b c d e f ≠ 0)
    (h : (gaugeRowU g a b c d e : k) ≠ (gaugeColU g a b c d f : k)) :
    assocGaugeF S g a b c d e f ≠ S.F a b c d e f := by
  intro hEq
  unfold assocGaugeF assocGaugeFactor at hEq
  simp only [Units.val_mul, Units.val_inv_eq_inv_val] at hEq
  have hc : ((gaugeColU g a b c d f : k)) ≠ 0 := (gaugeColU g a b c d f).ne_zero
  have hone : ((gaugeRowU g a b c d e : k)) * ((gaugeColU g a b c d f : k))⁻¹ = 1 := by
    refine mul_left_cancel₀ hF ?_
    rw [mul_one]
    exact hEq
  have h2 : ((gaugeRowU g a b c d e : k)) = ((gaugeColU g a b c d f : k)) := by
    have h3 := congrArg (fun x => x * (gaugeColU g a b c d f : k)) hone
    simp only [one_mul] at h3
    rwa [mul_assoc, inv_mul_cancel₀ hc, mul_one] at h3
  exact h h2

/-- **`J_match` is a gauge-invariant qualification**: the gauge keeps the fusion
ring and the carried twist, so a datum matches the derived twist exactly when
its gauge translate does.  With `derivedJGen_assocGauge` this says that the
truth of `J_match` at the *computed* twist is a property of the gauge class of
the associator representative. -/
theorem J_match_assocGauge_iff (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    J_match S (derivedJGen S) ↔
      J_match (assocGauge S g h0 h0' hd) (derivedJGen (assocGauge S g h0 h0' hd)) := by
  have hN : ∀ a b c : Fin n,
      0 < (assocGauge S g h0 h0' hd).ring.N a b c ↔ 0 < S.ring.N a b c := by
    intro a b c
    rw [assocGauge_ring]
  constructor
  · intro hJ a b c hP
    have hP' : 0 < S.ring.N a b c := (hN a b c).mp hP
    show (assocGauge S g h0 h0' hd).J a b c =
      derivedJGen (assocGauge S g h0 h0' hd) a b c
    rw [derivedJGen_assocGauge S g h0 h0' hd]
    exact hJ a b c hP'
  · intro hJ a b c hP
    have hP' : 0 < (assocGauge S g h0 h0' hd).ring.N a b c := (hN a b c).mpr hP
    have h1 : (assocGauge S g h0 h0' hd).J a b c =
        derivedJGen (assocGauge S g h0 h0' hd) a b c := hJ a b c hP'
    rw [derivedJGen_assocGauge S g h0 h0' hd] at h1
    exact h1

/-! ## §6 — the frozen interface at `ℂ`

The frozen statements of `Statements2` are stated about `derivedJ`, which is
`derivedJGen` at `ℂ` by `rfl`.  These are their representative-independence
corollaries: each is unchanged when the associator is moved by an admissible
cochain. -/

/-- B4's frozen `derivedJ` is invariant under the associator gauge. -/
theorem derivedJ_assocGauge {n : ℕ} (S : FusionSystem n ℂ)
    (g : Fin n → Fin n → Fin n → ℂˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (a b c : Fin n) :
    derivedJ (assocGauge S g h0 h0' hd) a b c = derivedJ S a b c :=
  derivedJGen_assocGauge S g h0 h0' hd a b c

/-- **The frozen nonvanishing target is a property of the gauge class**: it holds
of a datum exactly when it holds of any associator gauge translate.  So a proof
of `DerivedJ_ne_zero` on one representative gives it on the whole orbit. -/
theorem derivedJ_ne_zero_assocGauge_iff {n : ℕ} (S : FusionSystem n ℂ)
    (g : Fin n → Fin n → Fin n → ℂˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    (∀ a b c : Fin n, 0 < S.ring.N a b c → derivedJ S a b c ≠ 0) ↔
      (∀ a b c : Fin n, 0 < (assocGauge S g h0 h0' hd).ring.N a b c →
        derivedJ (assocGauge S g h0 h0' hd) a b c ≠ 0) := by
  have hN : ∀ a b c : Fin n,
      0 < (assocGauge S g h0 h0' hd).ring.N a b c ↔ 0 < S.ring.N a b c := by
    intro a b c
    rw [assocGauge_ring]
  constructor
  · intro h a b c hP
    rw [derivedJ_assocGauge S g h0 h0' hd]
    exact h a b c ((hN a b c).mp hP)
  · intro h a b c hP
    have hP' : 0 < (assocGauge S g h0 h0' hd).ring.N a b c := (hN a b c).mpr hP
    have h1 : derivedJ (assocGauge S g h0 h0' hd) a b c ≠ 0 := h a b c hP'
    rwa [derivedJ_assocGauge S g h0 h0' hd] at h1

/-- **The frozen pointed target is a property of the fusion ring**, which the
gauge does not move; the derived twist is invariant, so the `δ(κ)` statement is
gauge-invariant as well.  (`κ = coev * ev` is untouched: the gauge keeps `ev`
and `coev`.) -/
theorem derivedJ_pointed_assocGauge_iff {n : ℕ} (S : FusionSystem n ℂ)
    (g : Fin n → Fin n → Fin n → ℂˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1) :
    (∀ a b c : Fin n, 0 < S.ring.N a b c →
        derivedJ S a b c = S.kappa a * S.kappa b / S.kappa c) ↔
      (∀ a b c : Fin n, 0 < (assocGauge S g h0 h0' hd).ring.N a b c →
        derivedJ (assocGauge S g h0 h0' hd) a b c =
          (assocGauge S g h0 h0' hd).kappa a * (assocGauge S g h0 h0' hd).kappa b /
            (assocGauge S g h0 h0' hd).kappa c) := by
  have hN : ∀ a b c : Fin n,
      0 < (assocGauge S g h0 h0' hd).ring.N a b c ↔ 0 < S.ring.N a b c := by
    intro a b c
    rw [assocGauge_ring]
  have hK : ∀ i : Fin n, (assocGauge S g h0 h0' hd).kappa i = S.kappa i := fun i => rfl
  constructor
  · intro h a b c hP
    rw [derivedJ_assocGauge S g h0 h0' hd, hK, hK, hK]
    exact h a b c ((hN a b c).mp hP)
  · intro h a b c hP
    have hP' : 0 < (assocGauge S g h0 h0' hd).ring.N a b c := (hN a b c).mpr hP
    have h1 := h a b c hP'
    rw [derivedJ_assocGauge S g h0 h0' hd, hK, hK, hK] at h1
    exact h1

/-! ## §7 — non-vacuity of the gauge -/

/-- **The admissible cochains are not all trivial**: even with the three
normalisations that `assocGauge` needs, a cochain may differ from `1`.  So the
gauge is not the identity map on data (and by `assocGaugeF_ne_self` it moves `F`
whenever a non-zero entry has unequal row and column factors). -/
theorem assocGauge_exists_nontrivial :
    ∃ g : Fin 3 → Fin 3 → Fin 3 → ℚˣ,
      (∀ (hn : 0 < 3) (b : Fin 3), g ⟨0, hn⟩ b b = 1) ∧
      (∀ (hn : 0 < 3) (a : Fin 3), g a ⟨0, hn⟩ a = 1) ∧
      (∀ (hn : 0 < 3) (a : Fin 3), g a a ⟨0, hn⟩ = 1) ∧
      (g 1 1 2 : ℚ) ≠ 1 := by
  refine ⟨fun a b c =>
    if (a, b, c) = ((1 : Fin 3), 1, 2) then Units.mk0 2 (by norm_num) else 1,
    ?_, ?_, ?_, ?_⟩
  · intro hn b
    simp
  · intro hn a
    simp
  · intro hn a
    simp
  · norm_num

/-- **The gauge preserves the vanishing pattern of the associator**: the gauged
entry vanishes exactly when the original does.  (The gauge rescales blocks of
`F` by units, so it can neither create nor destroy a zero entry.  In particular
it cannot be used to move a datum into, or out of, the hypothesis
`F ⋯ ≠ 0` that the conditional form of `derivedJGen_eq_omegaCoeff` carries.) -/
theorem assocGaugeF_eq_zero_iff (S : FusionSystem n k) (g : Fin n → Fin n → Fin n → kˣ)
    (a b c d e f : Fin n) :
    assocGaugeF S g a b c d e f = 0 ↔ S.F a b c d e f = 0 := by
  unfold assocGaugeF
  constructor
  · intro h
    by_contra hF
    exact (mul_ne_zero hF (assocGaugeFactor g a b c d e f).ne_zero) h
  · intro h
    rw [h, zero_mul]

theorem assocGaugeFinv_eq_zero_iff (S : FusionSystem n k)
    (g : Fin n → Fin n → Fin n → kˣ) (a b c d f e : Fin n) :
    assocGaugeFinv S g a b c d f e = 0 ↔ S.Finv a b c d f e = 0 := by
  unfold assocGaugeFinv
  constructor
  · intro h
    by_contra hF
    exact (mul_ne_zero hF (gaugeColU g a b c d f * (gaugeRowU g a b c d e)⁻¹).ne_zero) h
  · intro h
    rw [h, zero_mul]

/-- **The two gauge freedoms compose**: applying the associator gauge to a
vertex-gauged datum changes the derived twist no more than either gauge alone.
So `derivedJGen` is invariant under the group generated by `Gauge.gauge` (the
duality normalisation, `derivedJGen_gauge`) and `assocGauge` (the associator
representative). -/
theorem derivedJGen_gauge_assocGauge (S : FusionSystem n k) (lam : Fin n → kˣ)
    (hlam : ∀ i, lam (S.ring.dual i) = lam i)
    (g : Fin n → Fin n → Fin n → kˣ)
    (h0 : ∀ (hn : 0 < n) (b : Fin n), g ⟨0, hn⟩ b b = 1)
    (h0' : ∀ (hn : 0 < n) (a : Fin n), g a ⟨0, hn⟩ a = 1)
    (hd : ∀ (hn : 0 < n) (a : Fin n), g (S.ring.dual a) a ⟨0, hn⟩ = 1)
    (a b c : Fin n) :
    derivedJGen (assocGauge (gauge S lam hlam) g h0 h0' hd) a b c =
      derivedJGen S a b c := by
  rw [derivedJGen_assocGauge (gauge S lam hlam) g h0 h0' hd]
  exact derivedJGen_gauge S lam hlam a b c

/-! ## §8 — canonicity: the closed form does not need the inverse data

`Finv` is a field of `FusionSystem`, carried because a block's two channel sets
need not be syntactically equal, but the two inverse laws determine it: two data
with the same fusion ring and the same associator have the same inverse
associator (`finv_eq_of_same_F`).  Hence `comparisonScalar` and `derivedJGen` are
functions of `(ring, F, ev)` alone (`comparisonScalar_eq_of_same_data`,
`derivedJGen_eq_of_same_data`): the WP3 closed form consumes exactly the data a
rigid structure supplies, and not a choice of inverse presentation. -/

variable {n : ℕ} {k : Type u} [Field k]

theorem sum_mul_ite_self (G : Fin n → k) (e₀ : Fin n) :
    (∑ e : Fin n, G e * (if e = e₀ then 1 else 0)) = G e₀ := by
  have hstep : ∀ e : Fin n, G e * (if e = e₀ then 1 else 0) =
      if e = e₀ then G e else 0 := by
    intro e
    by_cases h : e = e₀ <;> simp [h]
  simp only [hstep, Finset.sum_ite_eq', Finset.mem_univ, if_true]

/-- **The inverse associator is determined by the associator.**  Two data with
the same fusion ring and the same `F` have the same `Finv` everywhere: on the
supported blocks by the two inverse laws (a block has a unique inverse), off them
because both vanish by support.  `Finv` is carried as data only because the two
channel sets of a block need not be syntactically equal — it is not an
independent input. -/
theorem finv_eq_of_same_F (S S' : FusionSystem n k) (hring : S'.ring = S.ring)
    (hF : ∀ a b c d e f, S'.F a b c d e f = S.F a b c d e f)
    (a b c d f e : Fin n) :
    S'.Finv a b c d f e = S.Finv a b c d f e := by
  by_cases hf : 0 < S.ring.N b c f
  · by_cases hfd : 0 < S.ring.N a f d
    · -- the block is supported: the two inverse laws pin the entry
      have hf' : 0 < S'.ring.N b c f := by rw [hring]; exact hf
      have hfd' : 0 < S'.ring.N a f d := by rw [hring]; exact hfd
      by_cases he : 0 < S.ring.N a b e ∧ 0 < S.ring.N e c d
      · have hsub : ∀ f'' : Fin n,
            (∑ e' : Fin n, (S'.Finv a b c d f e' - S.Finv a b c d f e') * S.F a b c d e' f'') = 0 := by
          intro f''
          by_cases hf'' : 0 < S.ring.N b c f'' ∧ 0 < S.ring.N a f'' d
          · have h1' : (∑ e' : Fin n, S'.Finv a b c d f e' * S.F a b c d e' f'') =
                if f = f'' then 1 else 0 := by
              rw [← S'.Finv_comp a b c d f f'' hf' hfd' (by rw [hring]; exact hf''.1)
                (by rw [hring]; exact hf''.2)]
              exact Finset.sum_congr rfl fun e' _ => by rw [hF]
            have h2 : (∑ e' : Fin n, S.Finv a b c d f e' * S.F a b c d e' f'') =
                if f = f'' then 1 else 0 :=
              S.Finv_comp a b c d f f'' hf hfd hf''.1 hf''.2
            have hsub' : (∑ e' : Fin n, (S'.Finv a b c d f e' - S.Finv a b c d f e') * S.F a b c d e' f'')
                = (∑ e' : Fin n, S'.Finv a b c d f e' * S.F a b c d e' f'')
                  - (∑ e' : Fin n, S.Finv a b c d f e' * S.F a b c d e' f'') := by
              rw [← Finset.sum_sub_distrib]
              exact Finset.sum_congr rfl fun e' _ => by ring
            rw [hsub', h1', h2, sub_self]
          · have hzero : ∀ e' : Fin n, S.F a b c d e' f'' = 0 := by
              intro e'
              exact S.F_support a b c d e' f'' fun hcon => hf'' ⟨hcon.2.2.1, hcon.2.2.2⟩
            rw [Finset.sum_eq_zero]
            intro e' _
            rw [hzero e', mul_zero]
        have hinner : ∀ e' : Fin n,
            (∑ f' : Fin n, S.Finv a b c d f' e * S.F a b c d e' f') =
              if e' = e then 1 else 0 := by
          intro e'
          by_cases he' : 0 < S.ring.N a b e' ∧ 0 < S.ring.N e' c d
          · simpa only [eq_comm] using S.F_comp_inv a b c d e e' he.1 he.2 he'.1 he'.2
          · have hzero : ∀ f' : Fin n, S.F a b c d e' f' = 0 := by
              intro f'
              exact S.F_support a b c d e' f' fun hcon => he' ⟨hcon.1, hcon.2.1⟩
            rw [Finset.sum_eq_zero]
            · by_cases h : e' = e
              · exact absurd (h ▸ he) he'
              · rw [if_neg h]
            · intro f' _
              rw [hzero f', mul_zero]
        have hexp : (∑ f' : Fin n, S.Finv a b c d f' e *
              (∑ e' : Fin n, (S'.Finv a b c d f e' - S.Finv a b c d f e') * S.F a b c d e' f'))
            = ∑ e' : Fin n, (S'.Finv a b c d f e' - S.Finv a b c d f e') *
                (∑ f' : Fin n, S.Finv a b c d f' e * S.F a b c d e' f') := by
          simp only [Finset.mul_sum]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun e' _ => Finset.sum_congr rfl fun f' _ => by ring
        have hzero : (∑ f' : Fin n, S.Finv a b c d f' e *
            (∑ e' : Fin n, (S'.Finv a b c d f e' - S.Finv a b c d f e') * S.F a b c d e' f')) = 0 := by
          refine Finset.sum_eq_zero fun f' _ => ?_
          rw [hsub f', mul_zero]
        rw [hexp, Finset.sum_congr rfl (fun e' _ => by rw [hinner e']), sum_mul_ite_self] at hzero
        exact sub_eq_zero.mp hzero
      · have h0 : S'.Finv a b c d f e = 0 :=
          S'.Finv_support a b c d f e fun hcon =>
            he ⟨by rw [← hring]; exact hcon.2.2.1, by rw [← hring]; exact hcon.2.2.2⟩
        have h1 : S.Finv a b c d f e = 0 :=
          S.Finv_support a b c d f e fun hcon => he ⟨hcon.2.2.1, hcon.2.2.2⟩
        rw [h0, h1]
    · have h0 : S'.Finv a b c d f e = 0 :=
        S'.Finv_support a b c d f e fun hcon => hfd (by rw [← hring]; exact hcon.2.1)
      have h1 : S.Finv a b c d f e = 0 :=
        S.Finv_support a b c d f e fun hcon => hfd hcon.2.1
      rw [h0, h1]
  · have h0 : S'.Finv a b c d f e = 0 :=
      S'.Finv_support a b c d f e fun hcon => hf (by rw [← hring]; exact hcon.1)
    have h1 : S.Finv a b c d f e = 0 :=
      S.Finv_support a b c d f e fun hcon => hf hcon.1
    rw [h0, h1]

/-- **The comparison scalar depends only on `(ring, F, ev)`**: `Finv` is
reconstructed by `finv_eq_of_same_F`, so the closed form is a function of data
that a rigid structure supplies, not of a presentation choice of inverse. -/
theorem comparisonScalar_eq_of_same_data (S S' : FusionSystem n k) (hring : S'.ring = S.ring)
    (hF : ∀ a b c d e f, S'.F a b c d e f = S.F a b c d e f)
    (hev : ∀ i, S'.ev i = S.ev i) (x y z : Fin n) :
    comparisonScalar S' x y z = comparisonScalar S x y z := by
  unfold comparisonScalar
  by_cases hn : 0 < n
  · rw [dif_pos hn, dif_pos hn]
    have hdual : ∀ i : Fin n, S'.ring.dual i = S.ring.dual i := by
      intro i
      rw [hring]
    simp only [hdual, hF, hev, finv_eq_of_same_F S S' hring hF]
  · rw [dif_neg hn, dif_neg hn]

/-- **The derived twist depends only on `(ring, F, ev)`.**  The inverse
associator carried by `FusionSystem` is *determined* by the associator
(`finv_eq_of_same_F`), so it is not an independent input of the WP3 computation:
`derivedJGen` is a function of the fusion ring, the associator and the
evaluations. -/
theorem derivedJGen_eq_of_same_data (S S' : FusionSystem n k) (hring : S'.ring = S.ring)
    (hF : ∀ a b c d e f, S'.F a b c d e f = S.F a b c d e f)
    (hev : ∀ i, S'.ev i = S.ev i) (a b c : Fin n) :
    derivedJGen S' a b c = derivedJGen S a b c := by
  unfold derivedJGen
  rw [comparisonScalar_eq_of_same_data S S' hring hF hev,
    comparisonScalar_eq_of_same_data S S' hring hF hev]
  simp only [hring]

end FusionCategory

